{
  "name": "cinemoments",
  "version": "1.0.0",
  "description": "Cinema Interval Booking Platform with TMDB Importer",
  "type": "module",
  "scripts": {
    "import:movies": "node scripts/importMovies.js",
    "generate:diagrams": "node generate_diagrams.js",
    "start:website": "node server.js",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend run test",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix frontend run build"
  },
  "keywords": [
    "cinema",
    "interval-booking",
    "theatre",
    "screenings",
    "tmdb",
    "mongodb"
  ],
  "author": "CineMoments Team",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongodb": "^6.12.0"
  }
}
