# ==============================================================================
# CineMoments - Environment Configuration
# ==============================================================================

# MongoDB Connection URI (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://localhost:27017/cinemoments
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/cinemoments?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/cinemoments

# Target Database Name (optional, defaults to database specified in URI or "cinemoments")
MONGODB_DB_NAME=cinemoments

# TMDB (The Movie Database) API Access Token
# Obtain this by registering at https://www.themoviedb.org/signup
# and creating an API Read Access Token at https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=your_tmdb_api_read_access_token_here

# Number of popular movie pages to import (optional, defaults to 5; each page = 20 movies)
TMDB_PAGES=5

# TMDB Image Base URL (optional, defaults to https://image.tmdb.org/t/p/w500)
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# Web Showcase Server Port (optional, defaults to 3000)
PORT=3000
