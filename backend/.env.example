PORT=5000
NODE_ENV=development
JWT_SECRET=cinemoments_super_secret_jwt_key_2026_dev_mode_only!
JWT_EXPIRES_IN=7d

# 32-byte (256-bit) Hex Encoded Key for AES-256-GCM file encryption at rest
FILE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Upload directory
UPLOAD_DIR=./uploads

# MongoDB configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/cinemoments?retryWrites=true&w=majority

# Client URL for CORS
CLIENT_URL=http://localhost:5173
